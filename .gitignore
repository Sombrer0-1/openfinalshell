# Android/Gradle build output
android/.gradle/
android/**/build/
# CMake/NDK intermediate output for the privileged PTY host. It sits outside build/, so it needs its
# own entry — it contains generated makefiles and absolute toolchain paths.
android/**/.cxx/
android/local.properties

# Local Android toolchain downloads (never commit SDK/Gradle binaries or caches)
.local/android-sdk/
.local/gradle/
.local/gradle-user-home/
.local/jdk17/

# OS noise
*.local
*.log
.DS_Store
Thumbs.db
